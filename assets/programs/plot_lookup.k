%----------

mem $lcdstart 0x9d
mem $lcdend 0xfd
ldf $lcdstart
.lcdloop
lfp
fin
cwf $lcdend
jmp 0x3 .lcdout
jmp .lcdloop
.lcdout
%----------

% set stack pointer
mem 0xff 0xff

mem $ptr
mem $basePtr 0x40
mem $xlim 0x14
%=-=-=-=-=-=-==-=
.lookup

ldf $xin
fad $basePtr
saf $ptr
psh $ptr
pod $yin

% allocate vars 
mem $xin 0x0
mem $yin
mem $x
mem $y

mem $cnt

%==========
.printXY

% convert y
mem $yneg 0xf
ldf $yneg
fsu $yin
saf $y

% deal with 5x8 chars
ldf $xin
mem $five 0x5
.divloop
cwf $five
jmp 0x2 .outdiv % jmp if f<5
fsu $five
saf $x
% move "right" in mem
mem $yplus1 0x10
ldf $yplus1
fad $y
saf $y
ldf $x
jmp .divloop
.outdiv
saf $x

% reset counter
clr $cnt

mem $x0 0x10
ldf $x0

% shift single bit
.shftloop
ldb $cnt
cwb $x
jmp 0x3 .outshft
fdx
inc $cnt
jmp .shftloop
.outshft
saf $x

% y is address
mem $baseChar 0x40
ldf $baseChar
fad $y
mem $pos
saf $pos
% go to char mem
lcf

% read moves down,
% have to save add.
mem $null
lcd 0x3 00
lda $null
mem $add
add $add

% go back to add.
ldf $pos
lcf

% change bit
ldf $x
for $add
mem $toChar 0x200
for $toChar
lcf

% update x
inc $xin
ldb $xin
cwb $xlim
jmp 0x3 .outlookup
jmp .lookup

.outlookup

hlt
