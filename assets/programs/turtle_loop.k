mem 0xfc 0x221

mem 0xff 0xff

%nop

mem $lcdstart 0x9b
mem $lcdend 0xfd
ldf $lcdstart
.lcdloop
lfp
fin
cwf $lcdend
jmp 0x3 .poll
jmp .lcdloop

%----------

mem $yx 0x808

mem $xin
mem $yin
mem $dir 0x0

mem $x0 0x10

%----
.poll

%======

mem $cnt

%==========
.printXY

mem 0x60 0x100
mem 0x61 0x101
mem 0x62 0x001
mem 0x63 0xf01
mem 0x64 0xf00
mem 0x65 0xf0f
mem 0x66 0x00f
mem 0x67 0x10f

mem $lookup 0x60
for $lookup
mem $dum 
saf $dum
psh $dum
pod $dum % dereference
ldf $dum
%hlt

mem $yxmask 0xf0f
fad $yx
fan $yxmask
saf $yx

ghf 
saf $yin
ldf $yx
mem $xmask 0x0f
fan $xmask
saf $xin

% deal with 5x8 chars
ldf $xin
mem $five 0x5
.divloop
cwf $five
jmp 0x2 .outdiv % jmp if f<5
fsu $five
saf $xin
% move "right" in mem
mem $yplus1 0x10
ldf $yplus1
fad $yin
saf $yin
ldf $xin
jmp .divloop
.outdiv
saf $xin

% reset counter
clr $cnt

mem $x0 0x10
ldf $x0

% shift single bit
.shftloop
ldb $cnt
cwb $xin
jmp 0x3 .outshft
fdx
inc $cnt
jmp .shftloop
.outshft
saf $xin

% y is address
mem $baseChar 0x40
ldf $baseChar
fad $yin
mem $pos
saf $pos
% go to char mem
lcf

% read moves down,
% have to save add.
mem $null
lcd 0x3 00
lda $null
mem $add
add $add

% go back to add.
ldf $pos
lcf

% change bit
ldf $xin
fxo $add
mem $toChar 0x200
for $toChar
lcf

% ---- next ---
mem $n 
mem $nlim 0x3
inc $n

ldf $dir
fad $n

%hlt
ldb $n
cwb $nlim
jmp 0x2 .dirout
clr $n
%inc $nlim

.dirout
mem $seven 0x7
fan $seven
saf $dir

.loaddir
ldf $dir

jmp .poll


