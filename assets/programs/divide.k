% divide a/b
% load a,b
mem 0x80 0x16
mem 0x81 0x9

% dummy
mem 0xff 0x0
mem 0xee 0x0
mem 0xa0 0x230

%nop
inp 0x81

% copy a
lda 0x80
add 0x90

% check if a>b
.check
ldb 0x81
cwb 0x90
% if a>b, goto subtract
jmp 0x2 .sub
% if a=b, inc and leave
jmp 0x3 .inc
% else stop
jmp .done

% subtract, a-=b
.sub 
flp 0x81
lda 0x90
ldb 0x81 
awc 0x90
flp 0x81
inc 0xff % increment counter
jmp .check

% Mod = 0 if a/b=1
.inc
inc 0xff
lda 0xee
ldb 0xee
add 0x90

% a//b on lcd
.done 
lcd 0x38
lcd 0x0f
lcd 0x01
lcd 0x87

% hex to ascii
lda 0xff
ldb 0xa0
add 0xff % n+0x30 = char
ldf 0xff
lcf 

% remainder
lcd 0xc7
lda 0x90
ldb 0xa0
add 0xff % n+0x30 = char
ldf 0xff
lcf 

hlt