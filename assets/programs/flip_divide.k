% Print n++/input
mem 0x81 0x6

nop
clr 0x80
lcd 0x38
lcd 0x0f
lcd 0x80
lcd 0x2 0x61
lcd 0x2 0x2f
lcd 0x2 0x62
lcd 0xc0
lcd 0x2 0x61
lcd 0x2 0x25
lcd 0x2 0x62

.start
inc 0x80

% sri 0x77
% jmp .div

% divide(0x80,0x81)
% 0xff = a/b
% 0x90 = a%b
.div
clr 0xff
ldf 0x80
saf 0x90 % copy a to 0x90

% check if a>b
.check
ldf 0x81
cwf 0x90
jmp 0x2 .sub % a>b, subtract
jmp 0x3 .inc % a=b, increment
jmp .done % else stop

.sub 
ldf 0x90
fsu 0x81
saf 0x90
inc 0xff % increment counter
jmp .check

% Mod = 0 if a/b=1
.inc
inc 0xff
clr 0x90

% .out
% sro 0x77

% print
.done 
lcd 0x88
% h2a(a//b)
ldf 0xff
sri 0x77 
jmp .h2a

lcd 0xc8
% h2a(a%b)
ldf 0x90
sri 0x77 
jmp .h2a

jmp .start % restart

% hex_to_ascii(flip)
.h2a
mem 0xa0 0x230
fad 0xa0 % n+0x30 = char
lcf 
sro 0x77