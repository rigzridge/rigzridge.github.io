%nop

mem $lcdstart 0x9d
mem $lcdend 0xfd
ldf $lcdstart
.lcdloop
lfp
fin
cwf $lcdend
jmp 0x3 .poll
jmp .lcdloop

%----------

mem $xin 0x0
mem $yin 0x8

mem $x
mem $y

mem $x0 0x10

%jmp .printCoord

%----
.poll
ldf $yin
% handle input
con $both
mem $both 0x300
jmp 0x3 .select
%
con $right
mem $right 0x100
jmp 0x3 .right
%
con $left
mem $left 0x200
jmp 0x3 .left
%
jmp .poll
%----

.right
fin
jmp .topoll

.left
fde
.topoll
saf $yin
mem $lcdPnt 0x40
lcd 0xc6
for $lcdPnt
lfp
.printCoord
ldf $xin
lcd 0xc2
for $lcdPnt
lfp
jmp .poll

.select

%======

mem $cnt

.printxy
mem $yneg 0xf
ldf $yneg
fsu $yin
%fmx
saf $y

ldf $xin
mem $five 0x5
.divloop
cwf $five
jmp 0x2 .startplot % jmp if f<5
fsu $five
saf $x
mem $yplus1 0x10
ldf $yplus1
fad $y
saf $y
ldf $x
jmp .divloop

.startplot
saf $x

clr $cnt
ldf $x0

% get bit
.loop
ldb $cnt
cwb $x
jmp 0x3 .out
fdx
inc $cnt
jmp .loop

.out
saf $x

mem $baseChar 0x40
ldf $baseChar
fad $y
mem $pos
saf $pos
lcf

mem $null
lcd 0x3 00
lda $null
mem $dum
add $dum % save bit state

ldf $pos
lcf

ldf $x
for $dum
mem $toChar 0x200
for $toChar
lcf

inc $xin

jmp .printCoord


