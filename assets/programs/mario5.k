nop

mem 0xff 0xad
mem 0xfe 0xfb
ldf 0xff
.loop
lfp
fin
cwf 0xfe
jmp 0x3 .out
jmp .loop

.out

mem $pos 0x80
mem $toScreen 0x80
mem $toBottom 0x40

mem $goomba 0x12
mem $shot 0x0
mem $isShot 0x0

.moveMario
ldf $pos
lcf
lcd 0x2 0x0
lcd 0x2 0x1
for $toBottom
lcf
lcd 0x2 0x2
lcd 0x2 0x3

%----
.poll
ldf $pos
% handle input
con $both
mem $both 0x300
jmp 0x3 .select
%
con $right
mem $right 0x100
jmp 0x3 .rmove
%
con $left
mem $left 0x200
jmp 0x3 .lmove
%
ldb $isShot
mem $one 0x1
cwb $one
jmp 0x3 .shotLoop
jmp .poll
%----

.select
% return if shot's on 
ldb $isShot
cwb $one
jmp 0x3 .poll
% else initiate
ldf $pos
fin 
for $toBottom
lcf
lcd 0x2 0x6 % hand up
fin
saf $shot
inc $isShot

.shotLoop
ldf $shot
lcf
lcd 0x2 0x4
lcd 0x10
lcd 0x2 0x5
lcd 0x10
lcd 0x2 0x20
fin 
mem $shotOff 0xcf
cwf $shotOff
jmp 0x3 .killShot
saf $shot
jmp .poll

.killShot
clr $isShot
jmp .poll

.lmove
mem $leftWall 0x80
cwf $leftWall
jmp 0x3 .poll
fde
jmp .nowPrint

.rmove 
mem $rightWall 0x8e
cwf $rightWall
jmp 0x3 .poll
fin
.nowPrint
lcd 0x1
saf $pos
jmp .moveMario


hlt
%==========