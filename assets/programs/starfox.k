nop

lcd 0x38 % initialize
lcd 0x0c % cursor off
lcd 0x01 % clear
nop % END INITIALIZATION

lcd 0x40  % start custom chars
ldf 0x80  % load pointer
lfp       % perform lcd command @ pointer value
fin       % increment flip
cwf 0x81  % compare with limit
jmp 0x3 0xc  % jump if done
jmp 0x7
lcd 0x81     % goto start
lcd 0x2 0x00 % draw ship
ldf 0x70     % set initial position
nop % END DRAW SCREEN

jin 0x1 0x13  % check up/ down
jin 0x2 0x1a  % check shot
jmp 0x27      % shift screen

lcf           % goto ship pos
lcd 0x2 0x20  % draw blank
fxo 0xc0      % xor position
lcf           % goto new pos
lcd 0x2 0x00  % draw ship
jmp 0x11
nop % END UP/ DOWN

lcf           % goto pos
lcd 0x14      % move right
lcd 0x2 0x3d  % draw laser
lcd 0x2 0x3d  % draw laser
lcd 0x2 0x2a  % draw tip
lcd 0x10      % move left
lcd 0x04      % change input to left
lcd 0x2 0x20  % draw blank
lcd 0x2 0x20  % draw blank
lcd 0x2 0x20  % draw blank
lcd 0x06      % change input to right
jmp 0x27
nop % END SHOOT

lcf           % goto ship pos
lcd 0x2 0x20  % draw blank
fin           % increment pos
lcf           % must set ram address for read apparently
lcd 0x3 0x00  % send char data to regB
cwb 0xc1      % set fff flag if space has enemy
jmp 0x3 0x33  % jump to end game
lcd 0x10      % mem check moves cursor, must reverse !
lcd 0x2 0x00  % draw ship
lcd 0x18 % shift left
jmp 0x10
nop % END SHIFT

